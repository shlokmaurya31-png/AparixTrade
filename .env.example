# ── Aparix API (apps/api) ──────────────────────────────────────────────
# Local dev default: SQLite, zero setup required.
# Production target: PostgreSQL (see docker-compose.yml / docs/ARCHITECTURE.md).
DATABASE_URL=sqlite+aiosqlite:///./aparix_dev.db
# DATABASE_URL=postgresql+asyncpg://aparix:aparix@localhost:5432/aparix

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# AI — defaults to MockModelProvider so the repo runs with zero external
# services out of the box. Two ways to activate a real model:
#   AI_PROVIDER=ollama   -> local Ollama (see OLLAMA_* below), no API key,
#                            no cost. Requires `ollama serve` running and
#                            OLLAMA_MODEL pulled (`ollama pull llama3.1`).
#   AI_PROVIDER=anthropic -> not implemented yet; ANTHROPIC_API_KEY is a
#                            placeholder for when it is.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_REQUEST_TIMEOUT_SECONDS=60

CORS_ORIGINS=http://localhost:3000

# Admin dashboard access — comma-separated email allowlist, checked
# dynamically (not a stored role/RBAC system, see docs/ARCHITECTURE.md
# Phase 3 trade-offs). Add your account's email, restart the API, and the
# Admin nav item appears after you re-log-in.
ADMIN_EMAILS=

# Broker integration (Phase 5, domains/broker) — mirrors the AI_PROVIDER
# pattern. Default "mock" simulates a connected broker account with zero
# external deps; "zerodha" activates the real Kite Connect adapter (see
# https://developers.kite.trade, a paid subscription).
BROKER_PROVIDER=mock

# Required before any /broker/connect call — encrypts broker credentials/
# tokens at rest (core/crypto.py). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROKER_ENCRYPTION_KEY=

# Only meaningful when BROKER_PROVIDER=zerodha (https://developers.kite.trade).
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URL=http://localhost:3000/broker/callback

# Real order placement through a connected broker stays off even once
# Zerodha is wired with real credentials — a separate, deliberate step.
# See docs/ARCHITECTURE.md Phase 5 trade-offs.
BROKER_LIVE_TRADING_ENABLED=false

# ── Aparix Web (apps/web) ───────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
